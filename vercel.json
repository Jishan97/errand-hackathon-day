{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run check && npm test",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/voice/incoming",
      "destination": "/api/phone"
    },
    {
      "source": "/api/voice/outgoing",
      "destination": "/api/phone"
    },
    {
      "source": "/api/voice/connect",
      "destination": "/api/phone"
    },
    {
      "source": "/api/voice/authenticate",
      "destination": "/api/phone"
    },
    {
      "source": "/api/media",
      "destination": "/api/phone"
    },
    {
      "source": "/api/assistant/worker",
      "destination": "/api/phone"
    },
    {
      "source": "/api/internal/assistant/status",
      "destination": "/api/phone"
    },
    {
      "source": "/api/phone/health",
      "destination": "/api/phone"
    },
    {
      "source": "/healthz",
      "destination": "/health.json"
    }
  ],
  "headers": [
    {
      "source": "/image.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/healthz",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/incident.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
